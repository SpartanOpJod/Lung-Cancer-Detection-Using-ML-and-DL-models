# ========================
# Python / Cache
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.ipynb_checkpoints/

# ========================
# Virtual Environments
# ========================
venv/
env/
ENV/
.venv/

# ========================
# Build / Distribution
# ========================
build/
dist/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
MANIFEST

# ========================
# IDE / OS
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ========================
# Logs
# ========================
logs/
*.log

# ========================
# Environment Variables
# ========================
.env
.env.*
!.env.example

# ========================
# Frontend (React)
# ========================
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.eslintcache
frontend/coverage/

# ========================
# Node
# ========================
node_modules/
npm-debug.log*
yarn-error.log*

# ========================
# Data (VERY IMPORTANT)
# ========================
data/raw/
data/processed/
data/features/
data/**/*.npy
data/**/*.npz

# keep metadata CSVs
!data/meta/*.csv

# ========================
# Models
# ========================
models/ml/
models/**/*.pkl

# Ignore all DL checkpoints by default
models/**/*.pth
models/**/*.pt

# Allow ONLY best deployed model (Git LFS)
!models/dl/efficientnet_b0_hybrid_best.pth

# ========================
# Temporary / Cache
# ========================
*.tmp
*.temp
.cache/

# Meta backups (not needed)
data/meta/backup/
data/meta/backup_before_merge/
data/meta/**/*.bak

.idea/shelf/
.idea/**/shelf/
